# The vault is real files on disk and must never enter git.
vault/

# Sprite families: 579 files, 140 MB, every one referenced by the manifest.
# `brushes` and `timbre` are committed so a clone can boot and draw; the type
# families stay out until they are recompressed. They live in sketch-2-print
# and the manifest regenerates from whatever is present.
apps/*/gamepad_sprites/*
!apps/*/gamepad_sprites/brushes/
!apps/*/gamepad_sprites/timbre/

# Grid's material ramps, same bargain as the sprite families above: `trames`
# and `tiles` are 136 KB together and are enough to dither with, so they are
# committed. The heavy ones stay in grid_sketch until they are recompressed --
# stones alone is 4.9 MB, and all seven come to 8.8 MB.
apps/grid/materials/*
!apps/grid/materials/trames/
!apps/grid/materials/tiles/

# Published output belongs in gallery/, not beside the app. The manifest is
# generated from those images, so it is generated state too.
apps/*/gallery/images/*
!apps/*/gallery/images/.gitkeep
apps/*/gallery/manifest.json

node_modules/
.DS_Store
Thumbs.db
*.log

# Published objects live in gallery/ and ARE committed. Compress first:
#   oxipng -o4 --strip safe gallery/objects/**/*.png
